# ============================================
# API 配置模板文件
# ============================================
# 
# 使用说明:
# 1. 复制此文件为 `.env` (在同一目录下)
# 2. 填写你的真实 API密钥
# 3. 不要将 `.env` 文件提交到 Git
# 
# 支持的 AI 服务商:
# 
# 【硅基流动】(用于发票审核)
#   SILICONFLOW_API_KEY=your-siliconflow-api-key
#   SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
#   模型示例：Qwen/Qwen3.6-27B
#
# 【阿里云 DashScope】(合同审核使用)
#   DASHSCOPE_API_KEY=your-dashscope-api-key
#   DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   模型示例：qwen-plus
#
# 【MinerU】(用于 PDF 解析)
#   MINERU_API_KEY=your-mineru-api-key
#   MINERU_BASE_URL=https://mineru.net
#   官网：https://mineru.net
# ============================================

# ============================================
# LLM 配置 (用于发票识别、合同信息提取和审查)
# ============================================

# 硅基流动 API密钥 (推荐，用于发票审核)
# 获取方式：访问 https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=your-siliconflow-api-key-here

# API 基础 URL（发票审核使用）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ============================================
# MinerU PDF 解析服务配置
# ============================================

# MinerU API密钥
# 获取方式：访问 https://mineru.net 申请 API Token
MINERU_API_KEY=your-mineru-api-key-here

# MinerU 服务地址
MINERU_BASE_URL=https://mineru.net

# ============================================
# 可选配置
# ============================================

# 自定义模型名称 (不设置则使用默认模型)
# MODEL_NAME=Qwen/Qwen2.5-VL-72B-Instruct

# 阿里云 DashScope API密钥 (如果使用阿里云而非硅基流动)
# DASHSCOPE_API_KEY=your-dashscope-api-key
