# ============================================
# Git 忽略文件配置
# ============================================

# 环境变量文件 (包含 API密钥等敏感信息)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db

# 上传的文件 (用户数据)
DocumentAgent/backend/uploads/*
!DocumentAgent/backend/uploads/.gitkeep

# 后端运行时产物（临时/缓存/日志，不纳入版本管理）
# 单 skill 包装目录（由 invoice_agent._sync_skill_wrappers 自动从 skills/<dim> 同步生成，非源文件）
DocumentAgent/backend/skills/*_only/
DocumentAgent/backend/history/_debug.txt
DocumentAgent/backend/history/*_test.json
DocumentAgent/backend/history/*.log
DocumentAgent/backend/logs/
DocumentAgent/backend/parsed/*
!DocumentAgent/backend/parsed/.gitkeep
DocumentAgent/backend/conversation_history/
DocumentAgent/backend/nul
DocumentAgent/backend/invoice_extracted.json

# 前端
node_modules/
npm-debug.log
yarn-error.log
frontend.log
*.log

# 构建输出
build/
dist/
