# ============================================
# Git 忽略文件配置
# ============================================

# 环境变量文件 (包含 API密钥等敏感信息)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db

# 上传的文件 (用户数据)
DocumentAgent/backend/uploads/*
!DocumentAgent/backend/uploads/.gitkeep

# 前端
node_modules/
npm-debug.log
yarn-error.log

# 构建输出
build/
dist/
